COMPOSE_PROJECT_NAME=dats-action

GITHUB_OWNER=uhh-lt
GITHUB_REPO=dats
GITHUB_PAT=your-runner-pat

RUNNER_GPU_DEVICE_ID=0

# Shared Ray model cache on the host, mounted into all runners at /ray_cache
# e.g. /home/demo/ray_cache
RAY_CACHE_HOST_DIR=/path/to/ray/cache

# Shared uv cache on the host, mounted into all runners at /home/runner/.cache/uv
# Python dependencies are downloaded/built once and reused by all runners.
# e.g. /home/demo/uv_cache
UV_CACHE_HOST_DIR=/path/to/uv/cache

# Base directory for runner work directories (each runner gets a subdirectory)
# e.g. /home/demo/dats-runners-data
RUNNER_WORK_BASE_DIR=/path/to/runner/workdirs

# Copilot CLI BYOK (bring-your-own-key) model provider.
COPILOT_PROVIDER_BASE_URL=http://localhost:13133/v1
COPILOT_PROVIDER_TYPE=openai
COPILOT_PROVIDER_API_KEY=dummy-key
COPILOT_PROVIDER_WIRE_API=completions
COPILOT_PROVIDER_TRANSPORT=http
COPILOT_MODEL=your-served-model-name
COPILOT_PROVIDER_MAX_PROMPT_TOKENS=128000
COPILOT_PROVIDER_MAX_OUTPUT_TOKENS=16000
