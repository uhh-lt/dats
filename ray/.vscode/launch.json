{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ray",
      "type": "debugpy",
      "request": "attach",
      "preLaunchTask": "dev: ray (debug)",
      "connect": {
        "host": "localhost",
        "port": "${env:DEBUGPY_PORT_RAY}"
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "."
        }
      ],
      "justMyCode": true
    }
  ]
}
