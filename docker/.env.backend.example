#################### INFO ######################
# This file allows us to override all settings #
# specified in backend/configs/default.yaml    #
# Beware: settings in .env take precedence!    #
#################### INFO ######################

## API
API_MAX_UPLOAD_FILE_SIZE=1073741824
API_PRODUCTION_MODE=1
API_IS_STABLE=True

## Auth
# OIDC
AUTH_OIDC_ENABLED=False
AUTH_OIDC_PROVIDER_NAME=Authentik
AUTH_OIDC_CLIENT_ID=put-client-id-here
AUTH_OIDC_CLIENT_SECRET=put-client-secret-here
AUTH_OIDC_SERVER_METADATA_URL=http://my-auth-server/application/o/dats/.well-known/openid-configuration

# Mail settings
MAIL_ENABLED=False
MAIL_FROM=dats@uni-hamburg.de
MAIL_USERNAME=USER
MAIL_PASSWORD=PASS
MAIL_SERVER=exchange.uni-hamburg.de
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
MAIL_USE_CREDENTIALS=True
MAIL_VALIDATE_CERTS=False

## Users
SYSTEM_USER_PASSWORD=12SYSTEM34
DEMO_USER_PASSWORD=demo
ASSISTANT_USER_PASSWOD=12ASSISTANT34

## Postgres
# Connection pool PER API worker process (uvicorn --workers API_WORKERS).
#
# Postgres max_connections is shared by two groups of clients:
#
#   NUM_CONNECTIONS_API     = API_WORKERS * (POSTGRES_POOL_SIZE + POSTGRES_MAX_OVERFLOW)
#                             (each of the API_WORKERS uvicorn processes keeps its own pool)
#
#   NUM_CONNECTIONS_WORKERS = (RQ_WORKERS_CPU + RQ_WORKERS_API + RQ_WORKERS_GPU) * 2
#                             (compose.yml overrides each RQ worker to
#                              POSTGRES_POOL_SIZE=1 + POSTGRES_MAX_OVERFLOW=1 = 2)
#
# INVARIANT:
#   NUM_CONNECTIONS_API + NUM_CONNECTIONS_WORKERS <= POSTGRES_MAX_CONNECTIONS
#
# With the shipped values (API_WORKERS=10, RQ_WORKERS_CPU=8, RQ_WORKERS_API=16,
# RQ_WORKERS_GPU=1, POSTGRES_MAX_CONNECTIONS=200):
#   NUM_CONNECTIONS_API     = 10 * (8 + 4)      = 120
#   NUM_CONNECTIONS_WORKERS = (8 + 16 + 1) * 2  =  50
#   total                   = 120 + 50          = 170 <= 200  (30 headroom)
#
# Before changing any of these values, run:
#   bin/pg_max_pool_sanity_check.sh
# It reads the real values from .env / .env.backend / compose.yml and fails if
# the invariant above would be violated.
POSTGRES_POOL_SIZE=8
POSTGRES_MAX_OVERFLOW=4

## Elasticsearch
ES_INDEX_PREFIX=dats
