#################### INFO #####################
# This file allows us to override some of the #
# settings specified in production.yaml       #
#################### INFO #####################

### Docker settings
COMPOSE_PROJECT_NAME=demo
# Remove profiles to disable containers (from right to left)
# Dependencies are as follows:
# rq < backend < frontend
COMPOSE_PROFILES=rq,backend,frontend
# Docker tag to use for pulling the backend and rq container(s)
DATS_BACKEND_DOCKER_VERSION=1.11.0
# Docker tag to use for pulling the ray container
DATS_RAY_DOCKER_VERSION=1.11.0
# Docker tag to use for pulling the frontend
DATS_FRONTEND_DOCKER_VERSION=1.11.0
# Which user and group to use for running processes inside containers.
# Set this to the user and group you're using outside the containers to be able to read and write in folders mapped to volumes.
# use `id -u` and `id -g` to get your user and group id
DOCKER_UID=121
DOCKER_GID=126

### 3rd Party Tokens (used by DATS backend & vLLM)
HF_HUB_TOKEN=replace-me-with-your-own-token

#########################
# Backend & RQ settings #
#########################
## LLM connection
LLM_PROVIDER_HOST=vllm-llm
LLM_PROVIDER_PORT=8000
LLM_PROVIDER_API_KEY=put-your-llm-api-key-here
EMB_PROVIDER_HOST=vllm-emb
EMB_PROVIDER_PORT=8000
EMB_PROVIDER_API_KEY=put-your-emb-api-key-here

## Ray connection
RAY_HOST=ray
RAY_PORT=8000

## Docling connection
DOCLING_HOST=docling
DOCLING_PORT=5001

## Glitchtip connection
# (Copy the DSN string from Glitchtip UI. However, host is glitchtip, port is 8000!)
GLITCHTIP_DSN_BACKEND=
GLITCHTIP_DSN_FRONTEND=

#############################
# DATS Backend API settings #
#############################
# These are the critical settings!
# The backend can be fully customized using .env.backend
## Docker specific-settings:
# Number of uvicorn worker processes. Each process keeps its OWN Postgres pool of
# POSTGRES_POOL_SIZE + POSTGRES_MAX_OVERFLOW connections (see .env.backend).
#
#   NUM_CONNECTIONS_API     = API_WORKERS * (POSTGRES_POOL_SIZE + POSTGRES_MAX_OVERFLOW)
#   NUM_CONNECTIONS_WORKERS = (RQ_WORKERS_CPU + RQ_WORKERS_API + RQ_WORKERS_GPU) * 2
#   NUM_CONNECTIONS_API + NUM_CONNECTIONS_WORKERS <= POSTGRES_MAX_CONNECTIONS
#
# Full breakdown in .env.backend. Verify with bin/pg_max_pool_sanity_check.sh.
API_WORKERS=10
API_EXPOSED=13120
# Logging ('critical', 'error', 'warning', 'info', 'debug', 'trace')
API_LOG_LEVEL=info
## API:
# Use `python -c "import uuid; print(uuid.uuid4())"` to generate a UUID namespace for the backend
API_UUID_NAMESPACE=
## Auth:
# Use `pwgen` to generate a secret or use any long random string
AUTH_JWT_SECRET=
# Use `pwgen` to generate a secret or use any long random string
AUTH_SESSION_SECRET=

##################
# Redis settings #
##################
REDIS_PASSWORD=dats123

#####################
# Postgres settings #
#####################
POSTGRES_DB=dats
POSTGRES_USER=datsuser
POSTGRES_PASSWORD=dats123
# Hard cap on total Postgres connections. Must satisfy:
#   NUM_CONNECTIONS_API + NUM_CONNECTIONS_WORKERS <= POSTGRES_MAX_CONNECTIONS
#   NUM_CONNECTIONS_API     = API_WORKERS * (POSTGRES_POOL_SIZE + POSTGRES_MAX_OVERFLOW)
#   NUM_CONNECTIONS_WORKERS = (RQ_WORKERS_CPU + RQ_WORKERS_API + RQ_WORKERS_GPU) * 2
# Full breakdown in .env.backend. Verify with bin/pg_max_pool_sanity_check.sh.
POSTGRES_MAX_CONNECTIONS=200

######################
# RQ Worker settings #
######################
# LOG LEVEL ('critical', 'error', 'warning', 'info', 'debug', 'trace')
RQ_LOG_LEVEL=info
RQ_WORKERS_CPU=8
RQ_WORKERS_API=16
RQ_WORKERS_GPU=1
RQ_DEVICE_IDS=1

#########################
# RQ Dashboard settings #
#########################
RQ_DASHBOARD_USERNAME=datsuser
RQ_DASHBOARD_PASSWORD=dats123
RQ_DASHBOARD_EXPOSED=13136

##########################
# DATS Frontend settings #
##########################
FRONTEND_EXPOSED=13100


###################################
# Ray settings (compose.ray.yaml) #
###################################
# LOG LEVEL ('critical', 'error', 'warning', 'info', 'debug', 'trace')
RAY_LOG_LEVEL=info
RAY_API_EXPOSED=13130
RAY_DASHBOARD_EXPOSED=13131
RAY_DEVICE_IDS=0
RAY_GLITCHTIP_DSN=

