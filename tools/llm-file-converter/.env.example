# llm-file-converter configuration
# Copy this file to `.env` and fill in your values.
# Every value can also be set via the corresponding CLI option (see --help).
# Precedence: CLI argument > environment variable > .env file > default.

# --- LLM connection (required) -------------------------------------------------
# Model name as served by your OpenAI-compatible endpoint (e.g. vLLM).
LLM_MODEL=

# Base URL of the OpenAI-compatible API.
# LLM_API_BASE=http://localhost:8000/v1

# API key for the endpoint. vLLM accepts any non-empty value (e.g. "EMPTY").
# LLM_API_KEY=EMPTY

# --- Conversion behavior -------------------------------------------------------
# Path to a custom Jinja2 prompt template file.
# If unset, the bundled default template is used.
# LLM_PROMPT_TEMPLATE=

# Metadata fields to extract, as a JSON object or a path to a JSON file.
# Example: {"year": {"type": "integer", "description": "Publication year"}}
# LLM_METADATA_FIELDS=

# Jinja2 template for output file names (without extension).
# Available variables: original_filename, original_stem, original_suffix, metadata, index
# Example: {{ original_stem }}_year-{{ metadata.year }}_month-{{ metadata.month }}
# LLM_FILENAME_TEMPLATE=

# Comma-separated list of file extensions to convert (without dots).
# LLM_EXTENSIONS=xml,txt,html,htm,md,csv,json

# Recurse into subdirectories of the input folder.
# LLM_RECURSIVE=true

# --- LLM request tuning --------------------------------------------------------
# Number of files converted concurrently.
# LLM_CONCURRENCY=4

# Validation retries per file after a malformed LLM response.
# LLM_MAX_RETRIES=2

# Sampling temperature.
# LLM_TEMPERATURE=0.0

# Maximum tokens in the LLM response.
# LLM_MAX_TOKENS=8192
